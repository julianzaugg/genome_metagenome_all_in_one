nextflow_pipeline {

    name "illumina_metagenome (stub)"
    script "main.nf"

    test("illumina_metagenome stub run completes and produces numbered outputs") {

        options "-stub"

        when {
            params {
                mode   = "illumina_metagenome"
                input  = "${projectDir}/assets/samplesheets/illumina_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = true
            }
        }

        then {
            assert workflow.success
            // key stages were scheduled
            assert workflow.trace.tasks().any { it.name.contains('SEQKIT_STATS') }
            assert workflow.trace.tasks().any { it.name.contains('FASTP') }
            assert workflow.trace.tasks().any { it.name.contains('SPADES') }
            assert workflow.trace.tasks().any { it.name.contains('COVERM_CONTIG') }
            assert workflow.trace.tasks().any { it.name.contains('CHECKV_CLUSTER') }
            assert workflow.trace.tasks().any { it.name.contains('RPKM_CALCULATE') }
            // numbered output dirs exist
            assert path("$outputDir/00_read_stats").exists()
            assert !path("$outputDir/00_read_stats/read_stat_report.tsv").readLines()[0].contains('Cleanifier')
            assert path("$outputDir/01_fastp").exists()
            assert path("$outputDir/10_coverm_scaffolds").exists()
            assert path("$outputDir/12_gene_catalogue").exists()
            assert path("$outputDir/23_rpkm").exists()
            assert path("$outputDir/23_rpkm/singlem_sample_rpkm.tsv").exists()
            assert path("$outputDir/23_rpkm/singlem_rpkm_means.tsv").exists()
            assert path("$outputDir/23_rpkm/gene_catalogue_rpkm_per_gene_normalised.tsv").exists()
            assert path("$outputDir/23_rpkm/gene_catalogue_mapped_reads_per_gene.tsv").exists()
        }
    }

    test("illumina_metagenome stub run reports host removal in the read-stat report") {

        options "-stub"

        when {
            params {
                mode   = "illumina_metagenome"
                input  = "${projectDir}/assets/samplesheets/illumina_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = false
                cleanifier_db = "${projectDir}/tests/data/dbs/cleanifier/host.filter"
                skip_assembly = true
                skip_binning = true
                skip_gene_catalogue = true
                skip_mobile_elements = true
                skip_rpkm = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('CLEANIFIER') }
            assert path("$outputDir/00_read_stats/SAMPLE_A.cleanifier.seqkit_stats.tsv").exists()
            def header = path("$outputDir/00_read_stats/read_stat_report.tsv").readLines()[0].split('\t') as List
            assert header.containsAll(['Cleanifier_count', 'Cleanifier_percent'])
            assert header.indexOf('Cleanifier_count') > header.indexOf('Fastp_percent')
        }
    }

    test("illumina_metagenome stub passes host-removed singletons to metaSPAdes") {

        options "-stub"

        when {
            params {
                mode   = "illumina_metagenome"
                input  = "${projectDir}/assets/samplesheets/illumina_metagenome.csv"
                outdir = "$outputDir"
                metaspades_singletons = true
                cleanifier_db = "${projectDir}/tests/data/dbs/cleanifier/host.filter"
                skip_binning = true
                skip_gene_catalogue = true
                skip_mobile_elements = true
                skip_rpkm = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().count { it.name.contains('COLLECT_SINGLETONS') } == 2
            assert workflow.trace.tasks().count { it.name.contains('CLEANIFIER_SINGLETONS') } == 2
            assert path("$outputDir/04_host_removed/singletons/SAMPLE_A.clean.fastq.gz").exists()
            assert path("$outputDir/05_metaspades/SAMPLE_A.scaffolds.fasta").exists()
        }
    }

    test("illumina_metagenome stub compares comparison-read strains against references + HQ MAGs") {

        options "-stub"

        when {
            params {
                mode   = "illumina_metagenome"
                input  = "${projectDir}/assets/samplesheets/illumina_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = true
                run_tracs = true
                run_instrain = true
                reference_genomes = "${projectDir}/tests/data/refs"
                reference_genome_extension = "fasta"
                strain_genome_source = "hq_ref_representatives"
                comparison_reads = "${projectDir}/assets/samplesheets/illumina_comparison_reads.csv"
                strain_include_comparison_reads = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().count { it.name.contains('TRACS_ALIGN') } == 3
            assert workflow.trace.tasks().count { it.name.contains('INSTRAIN_PROFILE') } == 3
            assert path("$outputDir/26_strain_reference/strain_reference_genomes.tsv").readLines()[0].endsWith('\torigin')
            def cohorts = path("$outputDir/26_strain_reference/strain_samples.tsv").readLines()
            assert cohorts.contains('ILL_CMP_1\tcomparison')
            assert cohorts.contains('SAMPLE_A\tmain')
        }
    }
}
