nextflow_pipeline {

    name "nanopore_metagenome (stub)"
    script "main.nf"

    test("nanopore_metagenome stub run completes from long-read FASTQ") {

        options "-stub"

        when {
            params {
                mode   = "nanopore_metagenome"
                input  = "${projectDir}/assets/samplesheets/nanopore_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = true
                run_nonpareil = false
                run_genomespot = false
                run_checkm1 = false
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('FASTPLONG') }
            assert workflow.trace.tasks().any { it.name.contains('MYLOASM') }
            // NANO_META_B is hybrid: its short reads polish its assembly, and only that
            assert workflow.trace.tasks().any { it.name.contains('POLYPOLISH (NANO_META_B)') }
            assert !workflow.trace.tasks().any { it.name.contains('POLYPOLISH (NANO_META_A)') }
            assert workflow.trace.tasks().count { it.name.contains('AVIARY_RECOVER') } == 2
            assert workflow.trace.tasks().any { it.name.contains('AVIARY_RECOVER') }
            assert workflow.trace.tasks().any { it.name.contains('COVERM_GENOME_ONT') }
            assert workflow.trace.tasks().any { it.name.contains('GENOME_TAXONOMY_QC') || it.name.contains('GTDBTK_CLASSIFYWF') }
            assert !workflow.trace.tasks().any { it.name.contains('DORADO_BASECALL') }
            // no host removal, so no Cleanifier stage in the read-stat report
            assert !path("$outputDir/00_read_stats/read_stat_report.tsv").readLines()[0].contains('Cleanifier')
        }
    }

    test("nanopore_metagenome stub run reports host removal in the read-stat report") {

        options "-stub"

        when {
            params {
                mode   = "nanopore_metagenome"
                input  = "${projectDir}/assets/samplesheets/nanopore_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = false
                cleanifier_db = "${projectDir}/tests/data/dbs/cleanifier/host.filter"
                skip_assembly = true
                skip_binning = true
                skip_gene_catalogue = true
                skip_mobile_elements = true
                skip_rpkm = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('CLEANIFIER') }
            assert path("$outputDir/00_read_stats/NANO_META_A.cleanifier.seqkit_stats.tsv").exists()
            def header = path("$outputDir/00_read_stats/read_stat_report.tsv").readLines()[0].split('\t') as List
            assert header.containsAll(['Cleanifier_count', 'Cleanifier_percent'])
            assert header.indexOf('Cleanifier_count') > header.indexOf('Fastplong_percent')
        }
    }

    test("nanopore_metagenome stub maps long comparison reads and expands the catalogue") {

        options "-stub"

        when {
            params {
                mode   = "nanopore_metagenome"
                input  = "${projectDir}/assets/samplesheets/nanopore_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = true
                run_genomespot = false
                run_checkm1 = false
                skip_polypolish = true
                comparison_reads = "${projectDir}/assets/samplesheets/nanopore_comparison_reads.csv"
                comparison_assemblies = "${projectDir}/assets/samplesheets/comparison_assemblies.csv"
            }
        }

        then {
            assert workflow.success
            assert !workflow.trace.tasks().any { it.name.contains('POLYPOLISH') }
            assert !workflow.trace.tasks().any { it.name.contains('NONPAREIL') }
            assert workflow.trace.tasks().any { it.name.contains('FASTPLONG_COMPARISON') }
            assert workflow.trace.tasks().any { it.name.contains('COVERM_GENOME_COMPARISON_ONT') }
            assert !workflow.trace.tasks().any { it.name.contains('RPKM_') }
            assert workflow.trace.tasks().any { it.name.contains('CDHIT_EXPANDED') }
            assert path("$outputDir/33_comparison_reads/bin_mapping").exists()
            assert path("$outputDir/34_comparison_assemblies").exists()
        }
    }

    test("nanopore_metagenome stub runs TRACS on references only, with comparison reads") {

        options "-stub"

        when {
            params {
                mode   = "nanopore_metagenome"
                input  = "${projectDir}/assets/samplesheets/nanopore_metagenome.csv"
                outdir = "$outputDir"
                skip_host_removal = true
                skip_polypolish = true
                run_tracs = true
                reference_genomes = "${projectDir}/tests/data/refs"
                strain_genome_source = "references"
                comparison_reads = "${projectDir}/assets/samplesheets/nanopore_comparison_reads.csv"
                strain_include_comparison_reads = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('COVERM_CLUSTER_STRAIN_REF') }
            assert workflow.trace.tasks().count { it.name.contains('TRACS_ALIGN_ONT') } == 3
            assert path("$outputDir/30_strain_reference/reference_clusters/representatives/ref_a.fasta").exists()
            assert path("$outputDir/30_strain_reference/strain_samples.tsv").readLines().contains('NANO_CMP_1\tcomparison')
        }
    }
}
