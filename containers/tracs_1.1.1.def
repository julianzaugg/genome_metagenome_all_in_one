Bootstrap: docker
From: mambaorg/micromamba:1.5.8

# TRACS, built FROM SOURCE on the machine that will run it.
#
# Why not the quay.io biocontainer: TRACS's setup.py hard-codes
#   extra_compile_args = ["-O3", "-ffast-math", "-march=native"]
# so its pybind11 extension is compiled for whatever CPU built it. The bioconda
# image therefore only runs on hosts whose CPU is at least as new as the build
# host's; anywhere else it dies with SIGILL ("Illegal instruction (core
# dumped)", exit 132) on first use. Upstream issue #8 reports exactly this and
# was closed by the reporter, not by a fix -- the flag is still present on main
# (v1.1.1). Which hosts the published image works on is therefore decided by
# bioconda's build machine, and can change on any rebuild.
#
# Building here means -march=native targets THIS machine. Build it on the
# compute host (or one with the same/older CPU) -- a SIF built on a newer CPU
# reintroduces the exact same failure.
#
# NOTE: cxx-compiler is required, not optional. Without a C++ toolchain the
# build fails late, in pybind11's auto_cpp_level, with the misleading message
# "Unsupported compiler -- at least C++11 support is needed!". conda-forge's
# compilers also ship activation scripts that do NOT run in %post, so CC/CXX
# are exported explicitly below.

%post
    set -eu

    # ------------------------------------------------------------------
    # Target architecture for the compiled extension.
    #   native      = this build machine's CPU (default; fastest, least portable)
    #   x86-64-v2   = portable baseline for mixed/older hardware (SSE4.2, ~2009+)
    #   x86-64-v3   = AVX2 baseline (~2013+)
    # Edit this line for a portable build. Applied by patching setup.py, because
    # setuptools appends extra_compile_args last, so CFLAGS cannot override them.
    # ------------------------------------------------------------------
    TRACS_MARCH="native"

    micromamba install -y -n base -c conda-forge -c bioconda \
        python=3.12 pip \
        cxx-compiler pybind11 boost-cpp zlib \
        numpy scipy pandas plotly matplotlib-base pyfastx tqdm joblib \
        sourmash ncbi-genome-download \
        samtools minimap2 htsbox \
        git procps-ng
    micromamba clean -ay

    export PATH=/opt/conda/bin:$PATH
    export CC=$(ls /opt/conda/bin/*-linux-gnu-gcc | head -1)
    export CXX=$(ls /opt/conda/bin/*-linux-gnu-g++ | head -1)
    "$CXX" --version | head -1

    git clone --depth 1 --branch v1.1.1 https://github.com/gtonkinhill/tracs.git /opt/tracs
    if [ "$TRACS_MARCH" != "native" ]; then
        sed -i "s/-march=native/-march=${TRACS_MARCH}/" /opt/tracs/setup.py
    fi
    grep -n 'extra_compile_args = ' /opt/tracs/setup.py

    pip install --no-cache-dir --no-build-isolation /opt/tracs

    # Fail the build here rather than hours into a pipeline run. The import is
    # the check that matters: it is what SIGILLs when the extension does not
    # match the CPU.
    python -c "import TRACS; print('TRACS C++ extension loaded OK')"
    tracs --version
    for c in align combine distance cluster build-db; do
        tracs "$c" --help >/dev/null
    done
    for t in samtools minimap2 htsbox sourmash; do
        command -v "$t" >/dev/null || { echo "MISSING: $t" >&2; exit 1; }
    done
    echo "tracs build OK (-march=${TRACS_MARCH})"

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C

%runscript
    exec tracs "$@"
