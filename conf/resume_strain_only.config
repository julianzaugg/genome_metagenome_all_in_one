// Resume guard: add with -c to a -resume so only strain comparison (and the versions dump)
// may execute; any other cache miss fails at once instead of re-running (e.g. Aviary).
// beforeScript / errorStrategy are not part of the task hash, so cached tasks stay cached.
process {
    beforeScript  = 'echo "GUARD: a non-strain task was about to re-run; aborting" >&2; exit 1'
    errorStrategy = 'terminate'
    withName: '.*:STRAIN_COMPARISON:.*|.*COVERM_CLUSTER_STRAIN_REF|.*DUMP_SOFTWARE_VERSIONS' {
        beforeScript  = ':'
        errorStrategy = { task.exitStatus in ((130..145) - 132 + 104) ? 'retry' : 'finish' }
    }
}
