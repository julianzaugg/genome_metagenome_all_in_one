/*
 * Per-module tool flags (ext.args) and publishDir layout.
 *
 * publishDir mirrors the numbered-directory convention from the bash scripts so
 * outputs feel familiar. Numbers follow EXECUTION ORDER and are unique within a
 * mode. Each metagenome mode has its own numbering; the two isolate modes share
 * one scheme (so each has a few gaps). A process used by several modes looks its
 * directory up by mode: [illumina_metagenome: .., nanopore_metagenome: ..][params.mode].
 * Layouts are listed in docs/output.md -- keep the two in sync.
 * Tool flags live here — never hard-code them in process bodies. `versions.yml`
 * is never published.
 */

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    // ----------------------------------------------------------------------
    // QC
    // ----------------------------------------------------------------------
    withName: 'FASTP' {
        ext.args   = '--cut_front --cut_tail --cut_mean_quality 20 --length_required 50'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '01_fastp', nanopore_metagenome: '04_fastp', illumina_isolate: '04_fastp', nanopore_isolate: '04_fastp'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTQ_GZIP_TEST' {
        publishDir = [ enabled: false ]
    }
    withName: 'SEQKIT_STATS|READ_STAT_REPORT' {
        // per-stage stats and the aggregated read_stat_report.tsv share one dir
        publishDir = [ path: { "${params.outdir}/00_read_stats" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTPLONG' {
        ext.args   = '--length_required 500 --mean_qual 9'
        publishDir = [ path: { "${params.outdir}/03_fastplong" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'PORECHOP' {
        ext.args   = '--discard_middle'
        publishDir = [ path: { "${params.outdir}/02_porechop" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DORADO_BASECALL' { publishDir = [ path: { "${params.outdir}/01_dorado_basecall" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'DORADO_DEMUX'    { publishDir = [ path: { "${params.outdir}/01_dorado_basecall" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // Read profiling
    // ----------------------------------------------------------------------
    withName: 'SYLPH_SKETCH'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '02_sylph', nanopore_metagenome: '05_sylph'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SYLPH_PROFILE' {
        ext.args = { params.sylph_profile_args ?: '' }
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '02_sylph', nanopore_metagenome: '05_sylph'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SYLPH_TAX'     { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '02_sylph', nanopore_metagenome: '05_sylph'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SINGLEM_PIPE'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '03_singlem', nanopore_metagenome: '06_singlem'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // Host removal
    // ----------------------------------------------------------------------
    withName: 'CLEANIFIER_INDEX' {
        ext.args   = '-k 29 --windowsize 33'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '04_host_removed/index', nanopore_metagenome: '07_host_removed/index'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CLEANIFIER' {
        // --compression-threads defaults to a small pool if unset, so gzip (level 7) of the
        // output bottlenecks while most of --threads sits idle. Half of task.cpus for
        // compression, matching the manual baseline (example_script_dump/metagenome_nanopore/
        // run_cleanifier.sh: --threads 90 --compression-threads 40).
        ext.args = { "--compression gz --compression-level 7 --threshold 0.5 --buffersize 20 --compression-threads ${Math.max(1, (task.cpus / 2) as int)} --progress" }
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '04_host_removed', nanopore_metagenome: '07_host_removed'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Assembly
    // ----------------------------------------------------------------------
    withName: 'SPADES' {
        // metaSPAdes with the kmer set from run_metaspades.sh.
        // --metaspades_singletons adds fastp's unpaired reads as -s, like run_metaspades.sh
        // did with trimmomatic's singletons (patched nf-core module; see spades.diff).
        //
        // BayesHammer's k-mer counting can hang forever on some samples (unfixed
        // upstream CQF bug, ablab/spades#318): full CPU, zero progress, no error.
        // Workaround if hit: add '--only-assembler' to skip error correction, e.g.
        //   ext.args = { meta.id == 'RC12309' ? '--meta -k ... --only-assembler' : '--meta -k ...' }
        ext.args   = '--meta -k 21,33,55,81,99,127'
        publishDir = [ path: { "${params.outdir}/05_metaspades" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // --metaspades_singletons: unpaired reads -> host removal -> metaSPAdes -s
    withName: 'COLLECT_SINGLETONS' { publishDir = [ enabled: false ] }
    withName: 'CLEANIFIER_SINGLETONS' {
        ext.args = { "--compression gz --compression-level 7 --threshold 0.5 --buffersize 20 --compression-threads ${Math.max(1, (task.cpus / 2) as int)} --progress" }
        publishDir = [ path: { "${params.outdir}/04_host_removed/singletons" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'PREP_ASSEMBLY' {
        // the scaffolds every downstream step uses: metaSPAdes output minus scaffolds < 500 bp
        ext.args   = '--min-len 500'
        publishDir = [ path: { "${params.outdir}/05_metaspades" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MYLOASM' { publishDir = [ path: { "${params.outdir}/08_myloasm" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SHOVILL' {
        ext.args   = '--assembler spades --minlen 500'
        publishDir = [ path: { "${params.outdir}/05_shovill" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'AUTOCYCLER_ASSEMBLE' { publishDir = [ path: { "${params.outdir}/05_autocycler" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'DORADO_POLISH'       { publishDir = [ path: { "${params.outdir}/" + [nanopore_metagenome: '09_dorado_polish', nanopore_isolate: '06_dorado_polish'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'POLYPOLISH' {
        // --careful ignores multi-mapping reads: Polypolish's advice for low depth, which
        // most contigs in a metagenome are.
        ext.args   = { params.mode == 'nanopore_metagenome' ? '--careful' : '' }
        publishDir = [ path: { "${params.outdir}/" + [nanopore_metagenome: '10_polypolish', nanopore_isolate: '07_polypolish'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DNAAPLER'            { publishDir = [ path: { "${params.outdir}/08_dnaapler" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // Binning + dereplication + mapping
    // ----------------------------------------------------------------------
    withName: 'AVIARY_RECOVER' {
        // Skip aviary's internal steps that gmaio runs as separate processes.
        // --skip-singlem: gmaio profiles reads via SINGLEM_PIPE before binning.
        // --skip-taxonomy: gmaio runs GTDBTK_CLASSIFYWF on the final bin set.
        // --skip-abundances: gmaio computes coverages via COVERM_GENOME/CLUSTER.
        // Override ext.args to add/remove flags (e.g. --binning-only, --strict).
        ext.args           = '--skip-singlem --skip-taxonomy --skip-abundances'
        ext.long_read_type = { params.aviary_long_read_type ?: 'ont_hq' }
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '06_aviary', nanopore_metagenome: '11_aviary'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'AVIARY_COLLECT_BINS' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '06_aviary', nanopore_metagenome: '11_aviary'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'COVERM_CLUSTER' {
        // dereplicate bins at 95% ANI
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '08_dereplicated_bins', nanopore_metagenome: '13_dereplicated_bins'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CLUSTER_HQ' {
        // filter to HQ MAGs first, THEN dereplicate at 95% ANI
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '08_dereplicated_hq_bins', nanopore_metagenome: '13_dereplicated_hq_bins'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_HQ' {
        // same mapping settings as COVERM_GENOME, but genome-fasta-files is the HQ-only subset,
        // so competing near-identical lower-quality bins can't split reads away from the HQ rep
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_HQ_DEREP' {
        // map to the HQ-first-then-dereplicated set (extracted HQ from full bins, then clustered)
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CONTIG' {
        ext.args   = '--methods covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '10_coverm_scaffolds', illumina_isolate: '23_coverm_scaffolds'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // NOTE (all 7 minimap2-ont entries below and COVERM_GENOME_HQ_REF_ONT further down):
    // --min-read-aligned-percent 0.75 is evaluated per PRIMARY alignment record
    // (aligned_length / full_read_length). A chimeric/split long read whose
    // primary segment alone covers <75% of the read is discarded entirely --
    // including from the MAPPING_ASSESS bases-mapped metrics, which exist
    // specifically to give these reads credit. Left as-is for result
    // comparability; lowering or removing it here (and rerunning) would let
    // both the Count column and mapping-assessment metric C credit them.
    withName: 'COVERM_GENOME_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_HQ_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_HQ_DEREP_ONT' {
        // map to the HQ-first-then-dereplicated set (extracted HQ from full bins, then clustered)
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CONTIG_ONT' {
        ext.args   = '--methods covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [nanopore_metagenome: '15_coverm_scaffolds_nanopore', nanopore_isolate: '23_coverm_scaffolds_nanopore'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CONTIG_SR' {
        ext.args   = '--methods covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/23_coverm_scaffolds_illumina" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // Within-sample / within-group dereplication (per-unit; ${meta.id} = sample or group)
    withName: 'COVERM_CLUSTER_WS' {
        // dereplicate a single unit's bins at 95% ANI
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: "08_within_sample_dereplicated_bins/${meta.id}", nanopore_metagenome: "13_within_sample_dereplicated_bins/${meta.id}"][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CLUSTER_HQ_WS' {
        // filter a single unit's bins to HQ MAGs first, THEN dereplicate at 95% ANI
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: "08_within_sample_dereplicated_hq_bins/${meta.id}", nanopore_metagenome: "13_within_sample_dereplicated_hq_bins/${meta.id}"][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_WS_DEREP' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_within_sample_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_WS_HQ' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_within_sample_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_WS_DEREP_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_within_sample_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_WS_HQ_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_within_sample_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // MAPPING_ASSESS -- bases-mapped / percent-of-sequenced-bases metrics.
    // ext.filter_args mirrors the identity/aligned-percent thresholds of the
    // paired COVERM_GENOME*/COVERM_CONTIG* alias above, so bases-mapped
    // describes the same alignment set as that alias's Count column. Aliases
    // ending in _ONT/_SR must come AFTER their base-name counterpart below --
    // withName selectors are substring regexes (see the COVERM_GENOME_HQ_REF
    // / _ONT note further down).
    // ----------------------------------------------------------------------
    withName: 'MAPPING_ASSESS_SCAFFOLDS' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '10_coverm_scaffolds', illumina_isolate: '23_coverm_scaffolds'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_SCAFFOLDS_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [nanopore_metagenome: '15_coverm_scaffolds_nanopore', nanopore_isolate: '23_coverm_scaffolds_nanopore'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_SCAFFOLDS_SR' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/23_coverm_scaffolds_illumina" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_BINS' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_BINS_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_HQ_DIRECT' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_HQ_DIRECT_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_HQ_DEREP' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_HQ_DEREP_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_WS_DEREP' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_within_sample_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_WS_DEREP_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_within_sample_derep_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_WS_HQ' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_within_sample_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_WS_HQ_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_within_sample_hq_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // HQ_Ref_MAGs slot: filter_args paired with COVERM_GENOME_HQ_REF/_ONT further
    // down this file (dereplicated HQ MAGs + external reference genomes).
    withName: 'MAPPING_ASSESS_HQ_REF' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_ref_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_HQ_REF_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_ref_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Gene catalogue + annotation
    // ----------------------------------------------------------------------
    withName: 'PYRODIGAL' {
        ext.args   = '-p meta'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '11_pyrodigal', nanopore_metagenome: '16_pyrodigal'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // Per-genome proteins for GenomeSPOT / DRAM-bins (every bin, or each isolate
    // assembly). Kept apart from the per-sample scaffold proteins; isolates are single
    // genomes, so single mode (trained per genome) fits them better than -p meta.
    withName: 'PYRODIGAL_BINS' {
        ext.args   = { params.mode.endsWith('isolate') ? '-p single' : '-p meta' }
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '11_pyrodigal_bins', nanopore_metagenome: '16_pyrodigal_bins', illumina_isolate: '12_pyrodigal', nanopore_isolate: '12_pyrodigal'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CDHIT' {
        // common cd-hit flags; -c (identity) and -n (word size) are set per identity
        // in the module from params.catalogue_identities.
        ext.args   = '-d 0 -M 80000 -g 1'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue', nanopore_metagenome: '17_gene_catalogue'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CATALOGUE_PREP'     { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue', nanopore_metagenome: '17_gene_catalogue'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CATALOGUE_CDS'      { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue', nanopore_metagenome: '17_gene_catalogue'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CATALOGUE_TABULATE' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue', nanopore_metagenome: '17_gene_catalogue'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    // Gene catalogue: the split and per-chunk DRAM_ANNOTATE are intermediates —
    // disable publishing (they would otherwise land under the default per-process
    // dir) so only DRAM_ANNOTATE_MERGE publishes the reassembled result.
    // ext.args on the split is the number of chunks to scatter the catalogue into.
    // 'DRAM_ANNOTATE$' is $-anchored so it does not also match _BINS/_SPLIT/_MERGE.
    withName: 'DRAM_ANNOTATE_SPLIT' { ext.args = '16'; publishDir = [ enabled: false ] }
    withName: 'DRAM_ANNOTATE$'      { publishDir = [ enabled: false ] }
    withName: 'DRAM_ANNOTATE_MERGE' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '13_dram', nanopore_metagenome: '18_dram'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'DRAM_ANNOTATE_BINS' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: "14_dram_bins/${meta.id}", nanopore_metagenome: "19_dram_bins/${meta.id}", illumina_isolate: "14_dram_bins/${meta.id}", nanopore_isolate: "14_dram_bins/${meta.id}"][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    // Combined cross-MAG distillate: per-bin annotations are concatenated then
    // distilled once, published together under all_bins/ inside the dram_bins dir above.
    withName: 'DRAM_COMBINE_ANNOTATIONS' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '14_dram_bins/all_bins', nanopore_metagenome: '19_dram_bins/all_bins', illumina_isolate: '14_dram_bins/all_bins', nanopore_isolate: '14_dram_bins/all_bins'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'DRAM_DISTILL' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: "14_dram_bins/${meta.id}", nanopore_metagenome: "19_dram_bins/${meta.id}", illumina_isolate: "14_dram_bins/${meta.id}", nanopore_isolate: "14_dram_bins/${meta.id}"][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // RPKM
    // ----------------------------------------------------------------------
    withName: 'RPKM_FILTER_READS'     { publishDir = [ path: { "${params.outdir}/23_rpkm/filtered_reads" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_SINGLEM_MARKERS'  { publishDir = [ path: { "${params.outdir}/23_rpkm/singlem_markers" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_PREBUILT_SINGLEM_MARKERS' { publishDir = [ path: { "${params.outdir}/23_rpkm/singlem_markers" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_DIAMOND_MAKEDB'   { publishDir = [ enabled: false ] }
    withName: 'RPKM_DIAMOND_GENE' {
        ext.args   = '--evalue 0.00001 --min-score 40 --query-cover 80 --id 70 --max-hsps 1 --max-target-seqs 1'
        publishDir = [ path: { "${params.outdir}/23_rpkm/gene_blast/per_sample" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_COLLATE_GENE_BLAST' { publishDir = [ path: { "${params.outdir}/23_rpkm/gene_blast" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_DIAMOND_SINGLEM' {
        ext.args   = '--evalue 0.00001 --min-score 40 --query-cover 80 --id 70 --max-hsps 1 --max-target-seqs 1'
        publishDir = [ path: { "${params.outdir}/23_rpkm/singlem_blast" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_CALCULATE' { publishDir = [ path: { "${params.outdir}/23_rpkm" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // Genome taxonomy + QC
    // ----------------------------------------------------------------------
    withName: 'GTDBTK_CLASSIFYWF' {
        ext.args   = '--extension fasta'
        // When reference genomes are classified they carry the reserved USERREF_ prefix;
        // GTDBTK_RESTORE_NAMES then publishes a name-restored copy, so suppress the raw
        // (prefixed) output here to avoid a duplicate. Keep the expression in sync with
        // `classify_refs` in the metagenome workflows.
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '15_gtdbtk', nanopore_metagenome: '20_gtdbtk', illumina_isolate: '11_gtdbtk', nanopore_isolate: '11_gtdbtk'][params.mode] }, mode: params.publish_dir_mode,
                       enabled: !(params.reference_genomes && (params.reference_genomes_taxonomy || params.marker_tree_include_references)),
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'GTDBTK_RESTORE_NAMES' {
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '15_gtdbtk', nanopore_metagenome: '20_gtdbtk', illumina_isolate: '11_gtdbtk', nanopore_isolate: '11_gtdbtk'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CHECKM2_PREDICT'   { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '07_checkm2', nanopore_metagenome: '12_checkm2', illumina_isolate: '09_checkm2', nanopore_isolate: '09_checkm2'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CHECKM1_LINEAGEWF' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '16_checkm1', nanopore_metagenome: '21_checkm1', illumina_isolate: '10_checkm1', nanopore_isolate: '10_checkm1'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'NONPAREIL'         { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '17_nonpareil', nanopore_metagenome: '22_nonpareil'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'GENOMESPOT'         { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '18_genomespot', nanopore_metagenome: '23_genomespot', illumina_isolate: '13_genomespot', nanopore_isolate: '13_genomespot'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'GENOMESPOT_COMBINE' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '18_genomespot', nanopore_metagenome: '23_genomespot', illumina_isolate: '13_genomespot', nanopore_isolate: '13_genomespot'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'BARRNAP'           { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '19_barrnap', nanopore_metagenome: '24_barrnap', illumina_isolate: '15_barrnap', nanopore_isolate: '15_barrnap'][params.mode] },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // Marker-gene tree (MAGs + selected GTDB references; --run_marker_tree)
    // ext.args default to '' (tool defaults); override to pass tool flags, e.g.
    // MARKER_TREE_IQTREE ext.args = '-m MFP -mset LG -B 1000'.
    // ----------------------------------------------------------------------
    withName: 'MARKER_TREE_PREP' {
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '24_marker_tree', nanopore_metagenome: '28_marker_tree'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MARKER_TREE_VERYFASTTREE' {
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '24_marker_tree', nanopore_metagenome: '28_marker_tree'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MARKER_TREE_IQTREE' {
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '24_marker_tree', nanopore_metagenome: '28_marker_tree'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Strain comparison (metagenome) -- 26_strain_reference is shared by both tools,
    // so it is published whichever of --run_instrain / --run_tracs is enabled.
    //
    // NOTE: withName selectors are substring regexes, so TRACS_ALIGN_ONT must be
    // declared AFTER TRACS_ALIGN or the short-read preset would win for both.
    // ----------------------------------------------------------------------
    withName: 'STRAIN_GENOME_FILTER' {
        // Stricter than the pipeline HQ filter (comp - 3*cont >= 50): contamination
        // generates spurious SNVs and drives false "different strain" calls.
        ext.min_completeness  = params.strain_min_completeness
        ext.max_contamination = params.strain_max_contamination
        ext.hq_source         = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '26_strain_reference', nanopore_metagenome: '30_strain_reference'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CLUSTER_STRAIN_REF' {
        // --strain_genome_source references: one reference per 95% ANI species cluster
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '26_strain_reference', nanopore_metagenome: '30_strain_reference'][params.mode] + '/reference_clusters' }, mode: params.publish_dir_mode, saveAs: { fn -> (fn.equals('versions.yml') || fn.startsWith('high_quality_representatives')) ? null : fn } ]
    }
    withName: 'STRAIN_REFERENCE_PREP' {
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '26_strain_reference', nanopore_metagenome: '30_strain_reference'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // Genes for inStrain -g, called on the combined prefixed reference. Declared
    // here (after the bare 'PYRODIGAL' selector, which is a substring regex and
    // also matches this name) so it publishes beside the reference it describes
    // rather than into the plain pyrodigal dir above.
    withName: 'PYRODIGAL_STRAIN_REF' {
        ext.args   = '-p meta'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '26_strain_reference', nanopore_metagenome: '30_strain_reference'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // Index and per-sample BAMs are large and only consumed by INSTRAIN_PROFILE.
    withName: 'BOWTIE2_STRAIN_BUILD' { publishDir = [ enabled: false ] }
    withName: 'BOWTIE2_STRAIN_ALIGN' {
        // --no-unal keeps unmapped reads out of the BAM; inStrain ignores them anyway.
        ext.args   = '--no-unal'
        publishDir = [ enabled: false ]
    }
    withName: 'INSTRAIN_PROFILE' {
        // --database_mode sets --min_read_ani 0.92 --skip_mm_profiling
        // --min_genome_coverage 1, the right defaults when reads are mapped to a MAG
        // database rather than to their own assembly.
        ext.args   = '--database_mode --skip_plot_generation'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '27_instrain/profiles', nanopore_metagenome: '31_instrain/profiles'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'INSTRAIN_COMPARE' {
        // -ani/-cov define the same-strain call: popANI >= 0.99999 over >= 50% of the
        // genome is the conventional threshold. INSTRAIN_SUMMARISE reads the resulting
        // strain_clusters rather than re-deriving the call, so these are the single
        // source of truth -- tune here, not in the summary script.
        ext.args   = '--database_mode --skip_plot_generation -ani 0.99999 -cov 0.5'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '27_instrain', nanopore_metagenome: '31_instrain'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'INSTRAIN_SUMMARISE' {
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '27_instrain', nanopore_metagenome: '31_instrain'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'TRACS_BUILD_DB' {
        // --ksize / --scale tunable here if sourmash gather under-recovers low-abundance MAGs.
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '28_tracs', nanopore_metagenome: '32_tracs'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'TRACS_ALIGN' {
        ext.args   = '--minimap_preset sr --keep-all'
        publishDir = [ enabled: false ]
    }
    // Nanopore variant -- must come AFTER TRACS_ALIGN (substring selector) so map-ont wins.
    withName: 'TRACS_ALIGN_ONT' {
        ext.args   = '--minimap_preset map-ont --keep-all'
        publishDir = [ enabled: false ]
    }
    withName: 'TRACS_COMBINE' {
        // The combined MSAs are large and stay in work/; only the per-reference
        // sample-count summary is published (it is what diagnoses an empty
        // distance table).
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '28_tracs', nanopore_metagenome: '32_tracs'][params.mode] }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('combined_msa_summary.tsv') ? fn : null } ]
    }
    withName: 'TRACS_DISTANCE' {
        // --filter strips regions with unusual SNP patterns -- shared homology between
        // species/strains in mixed samples, and hard-to-align regions. With MAG
        // references (which carry some contamination) this is load-bearing, not optional.
        // No -D/--snp_threshold: it is a HARD cutoff applied inside pairsnp, so
        // any sample pair further apart than it is never emitted at all. That
        // silently deletes exactly the distant-strain pairs you need in order to
        // tell "these samples share no strains" from "nothing was comparable".
        // TRACS's own default is INT_MAX (no cutoff); set one only to bound
        // runtime on very large sample sets, and keep it an order of magnitude
        // above the smallest distance of interest.
        ext.args   = '--filter'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '28_tracs', nanopore_metagenome: '32_tracs'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'TRACS_CLUSTER' {
        ext.args   = '-D filter -c 10'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '28_tracs', nanopore_metagenome: '32_tracs'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Mobile elements (virus/plasmid)
    // ----------------------------------------------------------------------
    withName: 'GENOMAD_ENDTOEND' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '20_genomad', nanopore_metagenome: '25_genomad', illumina_isolate: '20_genomad', nanopore_isolate: '20_genomad'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'GENOMAD_PROCESS'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '20_genomad', nanopore_metagenome: '25_genomad', illumina_isolate: '20_genomad', nanopore_isolate: '20_genomad'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CHECKV_ENDTOEND'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '21_checkv', nanopore_metagenome: '26_checkv', illumina_isolate: '21_checkv', nanopore_isolate: '21_checkv'][params.mode] },  mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CHECKV_CLUSTER' {
        ext.args   = '--min_ani 95 --min_tcov 85 --min_qcov 0'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '22_checkv_clustering', nanopore_metagenome: '27_checkv_clustering', illumina_isolate: '22_checkv_clustering', nanopore_isolate: '22_checkv_clustering'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Isolate typing / comparative (isolate workflows)
    // ----------------------------------------------------------------------
    withName: 'BAKTA_BAKTA'       { publishDir = [ path: { "${params.outdir}/16_bakta" },     mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'BAKTA_STATS'       { publishDir = [ path: { "${params.outdir}/16_bakta" },     mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'MLST'              { publishDir = [ path: { "${params.outdir}/17_mlst" },      mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'AMRFINDERPLUS_RUN' { publishDir = [ path: { "${params.outdir}/18_amrfinder" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'AMRFINDERPLUS_COLLATE' { publishDir = [ path: { "${params.outdir}/18_amrfinder" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'ISESCAN'           { publishDir = [ path: { "${params.outdir}/19_isescan" },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'ISESCAN_COLLATE'   { publishDir = [ path: { "${params.outdir}/19_isescan" },   mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'PREP_COMPARISON_GROUPS' { publishDir = [ path: { "${params.outdir}/24_comparison_groups" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'PANAROO_RUN' {
        ext.args   = '--clean-mode strict --aligner mafft --core_threshold 0.99 --threshold 0.90 --alignment core --remove-invalid-genes --merge_paralogs'
        publishDir = [ path: { "${params.outdir}/28_panaroo" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'PARSNP'        { ext.args = '-c'; publishDir = [ path: { "${params.outdir}/26_parsnp" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'GUBBINS'       { publishDir = [ path: { "${params.outdir}/27_gubbins" },  mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'FASTANI'       { publishDir = [ path: { "${params.outdir}/25_fastani" },  mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CHEWBACCA_.*'  { publishDir = [ path: { "${params.outdir}/30_chewbacca" },mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'IQTREE'        { ext.args = '-fast -m GTR'; publishDir = [ path: { "${params.outdir}/29_tree" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // External reference genomes + expanded catalogue/RPKM (metagenome; --reference_genomes)
    // NB: withName selectors are substring regexes, so these aliased/new processes are
    // ALSO matched by their base selectors above (e.g. 'CDHIT' matches 'CDHIT_EXPANDED').
    // Defined here — LAST — so their publishDir overrides take precedence. Family numbers
    // are reused (08/09 dereplication, 12 catalogue, 13 dram, 23 rpkm) as elsewhere.
    // ----------------------------------------------------------------------
    withName: 'REFERENCE_PREP'             { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '25_reference_genomes', nanopore_metagenome: '29_reference_genomes'][params.mode] },         mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'REFERENCE_CHECKM2_VALIDATE' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '25_reference_genomes/checkm2', nanopore_metagenome: '29_reference_genomes/checkm2'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CHECKM2_PREDICT_REF'        { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '25_reference_genomes/checkm2', nanopore_metagenome: '29_reference_genomes/checkm2'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'PYRODIGAL_REFERENCE' {
        ext.args   = '-p meta'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '25_reference_genomes/proteins', nanopore_metagenome: '29_reference_genomes/proteins'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_CLUSTER_HQ_REF' {
        // dereplicate HQ MAGs together with the reference genomes at 95% ANI
        ext.args      = '--precluster-method finch --ani 0.95'
        ext.hq_source = params.hq_quality_source
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '08_dereplicated_hq_ref_bins', nanopore_metagenome: '13_dereplicated_hq_ref_bins'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_HQ_REF' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/09_coverm_hq_ref_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // Nanopore variant — must come AFTER COVERM_GENOME_HQ_REF (whose substring selector also
    // matches this name) so the minimap2-ont mapper args win.
    withName: 'COVERM_GENOME_HQ_REF_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/14_coverm_hq_ref_bins" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CATALOGUE_PREP_EXPANDED'     { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue_expanded', nanopore_metagenome: '17_gene_catalogue_expanded'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CDHIT_EXPANDED'              { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue_expanded', nanopore_metagenome: '17_gene_catalogue_expanded'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CATALOGUE_CDS_EXPANDED'      { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue_expanded', nanopore_metagenome: '17_gene_catalogue_expanded'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'CATALOGUE_TABULATE_EXPANDED' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '12_gene_catalogue_expanded', nanopore_metagenome: '17_gene_catalogue_expanded'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'DRAM_ANNOTATE_SPLIT_EXPANDED' { ext.args = '16'; publishDir = [ enabled: false ] }
    withName: 'DRAM_ANNOTATE_EXPANDED'       { publishDir = [ enabled: false ] }
    withName: 'DRAM_ANNOTATE_MERGE_EXPANDED' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '13_dram_expanded', nanopore_metagenome: '18_dram_expanded'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_DIAMOND_MAKEDB_EXPANDED' { publishDir = [ enabled: false ] }
    withName: 'RPKM_DIAMOND_GENE_EXPANDED' {
        ext.args   = '--evalue 0.00001 --min-score 40 --query-cover 80 --id 70 --max-hsps 1 --max-target-seqs 1'
        publishDir = [ path: { "${params.outdir}/23_rpkm_expanded/gene_blast/per_sample" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_COLLATE_GENE_BLAST_EXPANDED' { publishDir = [ path: { "${params.outdir}/23_rpkm_expanded/gene_blast" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_CALCULATE_EXPANDED' {
        // Only the gene-catalogue tables are meaningful here; the singlem_* tables are
        // identical to those under 23_rpkm (same marker blast), so drop them.
        publishDir = [ path: { "${params.outdir}/23_rpkm_expanded" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> (fn.equals('versions.yml') || fn.startsWith('singlem_')) ? null : fn } ]
    }

    // ----------------------------------------------------------------------
    // Comparison reads + comparison assemblies (metagenome; --comparison_reads /
    // --comparison_assemblies; 29/30 illumina, 33/34 nanopore). Every process here is an aliased *_COMPARISON
    // instance of an already-existing process (see subworkflows/local/comparison_reads.nf
    // and comparison_assemblies.nf) -- defined here, LAST, for the same reason the
    // _EXPANDED block above is: withName selectors are substring regexes, so these
    // need their specific entry to win over the generic base one.
    // ----------------------------------------------------------------------
    withName: 'PYRODIGAL_COMPARISON_ASSEMBLIES' {
        ext.args   = '-p meta'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '30_comparison_assemblies', nanopore_metagenome: '34_comparison_assemblies'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COMPARISON_ASSEMBLY_PREP' { publishDir = [ enabled: false ] }
    withName: 'SEQKIT_STATS_COMPARISON' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/read_stats', nanopore_metagenome: '33_comparison_reads/read_stats'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SYLPH_SKETCH_COMPARISON'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/sylph', nanopore_metagenome: '33_comparison_reads/sylph'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SYLPH_PROFILE_COMPARISON' { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/sylph', nanopore_metagenome: '33_comparison_reads/sylph'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SYLPH_TAX_COMPARISON'     { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/sylph', nanopore_metagenome: '33_comparison_reads/sylph'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'SINGLEM_PIPE_COMPARISON'  { publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/singlem', nanopore_metagenome: '33_comparison_reads/singlem'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'FASTP_COMPARISON' {
        ext.args   = '--cut_front --cut_tail --cut_mean_quality 20 --length_required 50'
        publishDir = [ path: { "${params.outdir}/29_comparison_reads/fastp" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    // nanopore_metagenome comparison reads: same long-read QC as the main samples
    withName: 'PORECHOP_COMPARISON' {
        ext.args   = '--discard_middle'
        publishDir = [ path: { "${params.outdir}/33_comparison_reads/porechop" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTPLONG_COMPARISON' {
        ext.args   = '--length_required 500 --mean_qual 9'
        publishDir = [ path: { "${params.outdir}/33_comparison_reads/fastplong" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CLEANIFIER_COMPARISON' {
        // see CLEANIFIER above re: --compression-threads / --progress
        ext.args = { "--compression gz --compression-level 7 --threshold 0.5 --buffersize 20 --compression-threads ${Math.max(1, (task.cpus / 2) as int)} --progress" }
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/host_removed', nanopore_metagenome: '33_comparison_reads/host_removed'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_COMPARISON' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-sr --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/bin_mapping', nanopore_metagenome: '33_comparison_reads/bin_mapping'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COVERM_GENOME_COMPARISON_ONT' {
        ext.args   = '--methods relative_abundance covered_fraction mean count --discard-unmapped --mapper minimap2-ont --min-covered-fraction 0.0 --bam-file-cache-directory . --min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/33_comparison_reads/bin_mapping" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_COMPARISON' {
        ext.filter_args = '--min-read-percent-identity 0.95 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/" + [illumina_metagenome: '29_comparison_reads/bin_mapping', nanopore_metagenome: '33_comparison_reads/bin_mapping'][params.mode] }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MAPPING_ASSESS_COMPARISON_ONT' {
        ext.filter_args = '--min-read-percent-identity 0.90 --min-read-aligned-percent 0.75'
        publishDir = [ path: { "${params.outdir}/33_comparison_reads/bin_mapping" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_FILTER_READS_COMPARISON'    { publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/filtered_reads" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_SINGLEM_MARKERS_COMPARISON' { publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/singlem_markers" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_PREBUILT_SINGLEM_MARKERS_COMPARISON' { publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/singlem_markers" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_DIAMOND_MAKEDB_COMPARISON'  { publishDir = [ enabled: false ] }
    withName: 'RPKM_DIAMOND_GENE_COMPARISON' {
        ext.args   = '--evalue 0.00001 --min-score 40 --query-cover 80 --id 70 --max-hsps 1 --max-target-seqs 1'
        publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/gene_blast/per_sample" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_COLLATE_GENE_BLAST_COMPARISON' { publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/gene_blast" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }
    withName: 'RPKM_DIAMOND_SINGLEM_COMPARISON' {
        ext.args   = '--evalue 0.00001 --min-score 40 --query-cover 80 --id 70 --max-hsps 1 --max-target-seqs 1'
        publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping/singlem_blast" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RPKM_CALCULATE_COMPARISON' { publishDir = [ path: { "${params.outdir}/29_comparison_reads/gene_catalogue_mapping" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ] }

    // ----------------------------------------------------------------------
    // DB downloads (--mode download_dbs) -> params.db_outdir
    // ----------------------------------------------------------------------
    withName: 'DL_.*' {
        publishDir = [ path: { "${params.outdir}/${params.db_outdir}" }, mode: 'copy' ]
    }

    // ----------------------------------------------------------------------
    // Intermediates — not published
    // ----------------------------------------------------------------------
    withName: 'CHECKV_COLLATE' { publishDir = [ enabled: false ] }

    // ----------------------------------------------------------------------
    // Pipeline summary
    // ----------------------------------------------------------------------
    withName: 'DUMP_SOFTWARE_VERSIONS' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

}
